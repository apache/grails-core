@import org.grails.forge.application.Project

@args (Project project)

package @project.getPackageName()

import grails.testing.gorm.DataTest
import spock.lang.Specification

class UserSpec extends Specification implements DataTest {

    Class[] getDomainClassesToMock() {
        [User, Role, UserRole]
    }

    void 'username and password are required'() {
        expect:
        !new User('', '').validate()
        new User('admin', 'secret').validate()
    }

    void 'authorities derive from role assignments'() {
        given:
        def user = new User('admin', 'secret').save(failOnError: true, flush: true)
        def role = new Role('ROLE_ADMIN').save(failOnError: true, flush: true)
        UserRole.create(user, role, true)

        expect:
        user.authorities*.authority == ['ROLE_ADMIN']
    }
}
