# ConfigReportCommand is registered by hand because CommandFactoriesTransformation compiles in
# the same source set — a global transform never runs on its own compilation unit.
org.apache.grails.core.cli.ApplicationCommand=org.apache.grails.core.cli.ConfigReportCommand
